{
  "name": "cloud-tools-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "client",
    "infrastructure/modules/lambda/src"
  ],
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1118.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/client-sqs": "^3.1118.0",
    "@aws-sdk/lib-dynamodb": "^3.1118.0",
    "dotenv": "^17.4.2",
    "fluent-ffmpeg-7": "^2.1.5",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "node-calibre": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "dev": "bun run --cwd client dev",
    "build": "bun run --cwd client build",
    "start": "bun run --cwd client start",
    "lint": "bun run --cwd client lint",
    "test": "bun run --cwd client test",
    "test:run": "bun run --cwd client test:run",
    "test:coverage": "bun run --cwd client test:coverage",
    "test:ui": "bun run --cwd client test:ui",
    "test:watch": "bun run --cwd client test:watch",
    "worker": "NODE_ENV=development tsx scripts/worker.ts",
    "setup": "./scripts/setup.sh",
    "verify": "./scripts/verify-setup.sh",
    "localstack:start": "./scripts/localstack.sh start",
    "localstack:stop": "./scripts/localstack.sh stop",
    "localstack:restart": "./scripts/localstack.sh restart",
    "localstack:status": "./scripts/localstack.sh status",
    "localstack:logs": "./scripts/localstack.sh logs",
    "localstack:reset": "./scripts/localstack.sh reset",
    "localstack:health": "./scripts/localstack.sh health",
    "test:integration": "./scripts/test-integration.sh",
    "type-check": "bun run --cwd client type-check",
    "type-check:all": "bun run type-check && bun run lambda:type-check",
    "lambda:type-check": "bun run --cwd infrastructure/modules/lambda/src type-check",
    "lambda:build": "bun run --cwd infrastructure/modules/lambda/src build",
    "lambda:clean": "bun run --cwd infrastructure/modules/lambda/src clean",
    "lambda:build:shell": "./scripts/build-lambda.sh",
    "build:all": "bun run build && bun run --cwd infrastructure/modules/lambda/src build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "shellcheck": "shellcheck scripts/*.sh infrastructure/scripts/*.sh",
    "shellcheck:strict": "shellcheck -S style scripts/*.sh infrastructure/scripts/*.sh",
    "terraform:fmt": "terraform fmt -recursive infrastructure/",
    "terraform:fmt:check": "terraform fmt -check -recursive infrastructure/",
    "terraform:validate": "cd infrastructure/environments/dev && terraform init -backend=false && terraform validate",
    "terraform:validate:prod": "cd infrastructure/environments/production && terraform init -backend=false && terraform validate",
    "terraform:lint": "cd infrastructure && tflint --recursive",
    "terraform:lint:init": "cd infrastructure && tflint --init",
    "terraform:docs": "terraform-docs markdown table --recursive --output-file README.md infrastructure/modules/",
    "terraform:all": "bun run terraform:fmt && bun run terraform:validate && bun run terraform:lint",
    "terraform:lint:local": "./infrastructure/scripts/lint.sh --all",
    "terraform:fmt:local": "./infrastructure/scripts/lint.sh --format",
    "check": "bun run format:check && bun run lint && bun run type-check:all && bun run docs:check && bun run check:loc",
    "docs:check": "markdownlint-cli2 && bun scripts/check-docs.ts",
    "check:loc": "bun scripts/check-loc.ts",
    "check:infra": "bash scripts/check-infra.sh",
    "test:e2e": "playwright test",
    "hooks:install": "pre-commit install --hook-type pre-commit --hook-type pre-push",
    "localstack:provision": "bash scripts/provision-localstack.sh",
    "check:security": "bun scripts/check-security.ts",
    "brand:build": "bun scripts/brand.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/aws-lambda": "^8.10.162",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "markdownlint-cli2": "0.23.3",
    "next": "16.3.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": ">=4.3.1",
    "@smithy/config-resolver@<4.4.0": ">=4.4.6",
    "fast-xml-parser": ">=5.5.6",
    "minimatch": ">=9.0.7",
    "brace-expansion": "5.0.12",
    "postcss": ">=8.5.18",
    "rollup": ">=4.59.0",
    "flatted": ">=3.4.2",
    "picomatch": ">=4.0.4",
    "vite": ">=8.2.2",
    "form-data": ">=4.0.6",
    "ws": ">=8.21.0",
    "sharp": ">=0.35.5",
    "source-map-js": ">=1.2.2"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
